msgstr "Não foi possível guardar a chave: o Cuprita não tem pasta de dados (defina HOME)"

msgid "Couldn't open {0} ({1}: {2}): open it yourself"
msgstr "Não foi possível abrir {0} ({1}: {2}): abra você mesmo"

msgid "Courtyards of {0} and {1} overlap on {2}"
msgstr "Os pátios de {0} e {1} se sobrepõem em {2}"

